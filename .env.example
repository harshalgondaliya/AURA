# .env.example
# Environment configuration template for AI Fashion Recommendation Platform

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fashion_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fashion_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Microservice Routing URLs (Internal Docker Network)
PRODUCT_SERVICE_URL=http://product_service:8001
REC_SERVICE_URL=http://recommendation_service:8002
USER_SERVICE_URL=http://user_service:8003

# Application Settings
ENVIRONMENT=production
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_RATE=1.0
