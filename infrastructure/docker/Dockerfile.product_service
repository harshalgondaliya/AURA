# infrastructure/docker/Dockerfile.product_service
FROM python:3.11-slim

WORKDIR /app

COPY requirements-services.txt .
RUN pip install --no-cache-dir -r requirements-services.txt

COPY backend/common /app/backend/common
COPY backend/services/product_service /app/backend/services/product_service

EXPOSE 8001
CMD ["uvicorn", "backend.services.product_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
